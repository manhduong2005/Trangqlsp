mixin search(keyword)
  form(id="form-search")
            .input-group 
              input(
                type = "text"
                placeholder = "Nhập từ khoá"
                name = "keyword"
                class = "form-control"
                value = keyword // - giá trị động duy nhất nên phải được truy
              )
              .input-group-append 
                button(
                  class="btn btn-success"
                  type="submit"
                ) Tìm


